[run]
branch = True
source =
    api
    electra_agents
omit =
    tests/*
    scripts/*
    **/__pyrefly_virtual__/**

[report]
show_missing = True
fail_under = 100
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    if TYPE_CHECKING:
